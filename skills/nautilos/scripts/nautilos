#!/usr/bin/env sh
# Wrapper: pick the prebuilt nautilos binary for this OS/arch and exec it.
# Falls back to a relative root when CLAUDE_PLUGIN_ROOT is unset (e.g. running
# the script directly out of the repo).
set -eu

root="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/../../.." && pwd)}"

os=$(uname -s)
arch=$(uname -m)
case "$os" in
  Darwin) os=darwin ;;
  Linux)  os=linux ;;
  *) printf '{"error":"unsupported OS: %s"}\n' "$os" >&2; exit 1 ;;
esac
case "$arch" in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64)  arch=x64 ;;
  *) printf '{"error":"unsupported arch: %s"}\n' "$arch" >&2; exit 1 ;;
esac

bin="$root/bin/nautilos-$os-$arch"
if [ ! -x "$bin" ]; then
  printf '{"error":"no prebuilt binary for %s-%s at %s; build with: jpm quickbin src/main.janet bin/nautilos-%s-%s"}\n' \
    "$os" "$arch" "$bin" "$os" "$arch" >&2
  exit 1
fi

exec "$bin" "$@"
